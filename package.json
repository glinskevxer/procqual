{
  "name": "arc",
  "version": "0.1.0",
  "description": "Weld procedure qualification, welder performance qualification and joint traceability for pressure equipment fabrication",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.cjs --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test",
    "arc": "tsx src/cli/main.ts"
  },
  "devDependencies": {
    "@types/node": "20.14.11",
    "@typescript-eslint/eslint-plugin": "7.17.0",
    "@typescript-eslint/parser": "7.17.0",
    "@vitest/coverage-v8": "2.0.4",
    "eslint": "8.57.0",
    "prettier": "3.3.3",
    "tsx": "4.16.2",
    "typescript": "5.5.4",
    "vitest": "2.0.4"
  },
  "bin": {
    "arc": "./dist/cli/main.js"
  },
  "dependencies": {
    "commander": "12.1.0"
  }
}
