{
  "name": "arc",
  "version": "0.1.0",
  "description": "Weld procedure qualification, welder performance qualification and joint traceability for pressure equipment fabrication",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run audit",
    "arc": "tsx src/cli/main.ts",
    "reference": "npm run build && node scripts/reference.mjs",
    "reference:check": "npm run build && node scripts/reference.mjs --check",
    "audit": "node scripts/audit-dependencies.mjs",
    "release:check": "npm run build && node scripts/release-check.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@types/node": "22.13.1",
    "@vitest/coverage-v8": "3.0.5",
    "eslint": "9.19.0",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.23.0",
    "vitest": "3.0.5"
  },
  "bin": {
    "arc": "./dist/cli/main.js"
  },
  "dependencies": {
    "commander": "13.1.0"
  },
  "keywords": [
    "welding",
    "asme",
    "qualification",
    "fabrication",
    "quality",
    "traceability"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/program.d.ts",
      "default": "./dist/cli/program.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "docs/cli.md"
  ],
  "sideEffects": false
}
